    var player = { x: 50, size: 40, color: "blue", speedX: 3, speedY: 2, direction: 1, directionY: 1 };
    
    function update() {
        clearScreen();
        circle(player.x, player.y, player.zize, player.color);
        player.x = player.x + player.speedX * player.direction;
        player.y = player.y + player.speedY * player.directionY;


        if (player.x + player.size > tolalWidth) {
            player.direction = -1;
        }
        if (player.x + player.size < 0) {
            player.direction = 1;
        }
        if (player.y - player.size < 0 ) {
            player.direction = 1; 
        }
